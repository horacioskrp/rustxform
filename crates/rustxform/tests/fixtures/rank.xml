<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Rank</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="rank_form">
          <pref/>
          <meta>
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="colors">
        <root>
          <item>
            <name>red</name>
            <label>Red</label>
          </item>
          <item>
            <name>green</name>
            <label>Green</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/pref" type="odk:rank"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <odk:rank ref="/data/pref">
      <label>Preference</label>
      <itemset nodeset="instance('colors')/root/item">
        <value ref="name"/>
        <label ref="label"/>
      </itemset>
    </odk:rank>
  </h:body>
</h:html>
