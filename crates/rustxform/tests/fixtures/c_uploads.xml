<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>F</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="f">
          <im/>
          <au/>
          <vi/>
          <fi/>
          <meta>
            <instanceID/>
          </meta>
        </data>
      </instance>
      <bind nodeset="/data/im" type="binary"/>
      <bind nodeset="/data/au" type="binary"/>
      <bind nodeset="/data/vi" type="binary"/>
      <bind nodeset="/data/fi" type="binary"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <upload ref="/data/im" mediatype="image/*">
      <label>Im</label>
    </upload>
    <upload ref="/data/au" mediatype="audio/*">
      <label>Au</label>
    </upload>
    <upload ref="/data/vi" mediatype="video/*">
      <label>Vi</label>
    </upload>
    <upload ref="/data/fi" mediatype="application/*">
      <label>Fi</label>
    </upload>
  </h:body>
</h:html>
