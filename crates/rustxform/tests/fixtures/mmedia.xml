<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>MMedia</h:title>
    <model odk:xforms-version="1.0.0">
      <itext>
        <translation lang="English (en)" default="true()">
          <text id="/data/pic:label">
            <value>Look</value>
            <value form="image">jr://images/en.png</value>
          </text>
        </translation>
        <translation lang="French (fr)">
          <text id="/data/pic:label">
            <value>Regarde</value>
            <value form="image">jr://images/fr.png</value>
          </text>
        </translation>
      </itext>
      <instance>
        <data id="mmedia">
          <pic/>
          <meta>
            <instanceID/>
          </meta>
        </data>
      </instance>
      <bind nodeset="/data/pic" readonly="true()" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/data/pic">
      <label ref="jr:itext('/data/pic:label')"/>
    </input>
  </h:body>
</h:html>
