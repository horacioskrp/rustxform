<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>F</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="f">
          <s1/>
          <s2/>
          <meta>
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="yn">
        <root>
          <item>
            <name>y</name>
            <label>Yes</label>
          </item>
          <item>
            <name>n</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="col">
        <root>
          <item>
            <name>r</name>
            <label>Red</label>
          </item>
          <item>
            <name>g</name>
            <label>Green</label>
          </item>
          <item>
            <name>b</name>
            <label>Blue</label>
          </item>
          <item>
            <name>w</name>
            <label>White</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/s1" type="string"/>
      <bind nodeset="/data/s2" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <select1 ref="/data/s1">
      <label>S1</label>
      <itemset nodeset="instance('yn')/root/item">
        <value ref="name"/>
        <label ref="label"/>
      </itemset>
    </select1>
    <select ref="/data/s2">
      <label>S2</label>
      <itemset nodeset="instance('col')/root/item">
        <value ref="name"/>
        <label ref="label"/>
      </itemset>
    </select>
  </h:body>
</h:html>
