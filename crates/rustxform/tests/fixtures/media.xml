<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Media</h:title>
    <model odk:xforms-version="1.0.0">
      <itext>
        <translation lang="default" default="true()">
          <text id="/data/withpic:label">
            <value>Pick</value>
            <value form="image">jr://images/logo.png</value>
          </text>
        </translation>
      </itext>
      <instance>
        <data id="media">
          <fullname/>
          <withpic/>
          <meta>
            <instanceID/>
          </meta>
        </data>
      </instance>
      <bind nodeset="/data/fullname" type="string"/>
      <bind nodeset="/data/withpic" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/data/fullname">
      <label>Your name</label>
    </input>
    <input ref="/data/withpic">
      <label ref="jr:itext('/data/withpic:label')"/>
    </input>
  </h:body>
</h:html>
