<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Choices</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="choices">
          <consent/>
          <likes/>
          <meta>
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="colors">
        <root>
          <item>
            <name>red</name>
            <label>Red</label>
          </item>
          <item>
            <name>green</name>
            <label>Green</label>
          </item>
          <item>
            <name>blue</name>
            <label>Blue</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/consent" type="string"/>
      <bind nodeset="/data/likes" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <select1 ref="/data/consent">
      <label>Do you consent?</label>
      <itemset nodeset="instance('yes_no')/root/item">
        <value ref="name"/>
        <label ref="label"/>
      </itemset>
    </select1>
    <select ref="/data/likes">
      <label>Colors you like</label>
      <itemset nodeset="instance('colors')/root/item">
        <value ref="name"/>
        <label ref="label"/>
      </itemset>
    </select>
  </h:body>
</h:html>
