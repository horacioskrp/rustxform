<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Advanced</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="advanced">
          <fullname/>
          <greeting/>
          <rating/>
          <meta>
            <instanceID/>
          </meta>
        </data>
      </instance>
      <bind nodeset="/data/fullname" type="string" constraint="string-length(.) &gt; 2" jr:constraintMsg="Too short" required="true()" jr:requiredMsg="Required!"/>
      <bind nodeset="/data/greeting" readonly="true()" type="string"/>
      <bind nodeset="/data/rating" type="int"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/data/fullname">
      <label>Your name</label>
    </input>
    <input ref="/data/greeting">
      <label> Hello <output value=" /data/fullname "/> </label>
    </input>
    <range ref="/data/rating" start="1" end="5" step="1">
      <label>Rate it</label>
    </range>
  </h:body>
</h:html>
